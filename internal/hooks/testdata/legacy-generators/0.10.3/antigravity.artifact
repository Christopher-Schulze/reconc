{
  "reconc": {
    "PostInvocation": [
      {
        "command": "sh -c 'repo=\".\"; hook=\"$repo/tools/reconc/bin/hook\"; if [ -x \"$hook\" ]; then exec \"$hook\" antigravity-post-invocation \"$repo\"; fi; repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2\u003e/dev/null || printf \"%s\" \"$repo\")\"; RECONC_HOOK_REPO_RESOLVED=1 exec \"$repo/tools/reconc/bin/hook\" antigravity-post-invocation \"$repo\"'",
        "timeout": 5,
        "type": "command"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'repo=\".\"; hook=\"$repo/tools/reconc/bin/hook\"; if [ -x \"$hook\" ]; then exec \"$hook\" antigravity-post-tool-use \"$repo\"; fi; repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2\u003e/dev/null || printf \"%s\" \"$repo\")\"; RECONC_HOOK_REPO_RESOLVED=1 exec \"$repo/tools/reconc/bin/hook\" antigravity-post-tool-use \"$repo\"'",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "view_file|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name|grep_search|run_command"
      }
    ],
    "PreInvocation": [
      {
        "command": "sh -c 'repo=\".\"; hook=\"$repo/tools/reconc/bin/hook\"; if [ -x \"$hook\" ]; then exec \"$hook\" antigravity-pre-invocation \"$repo\"; fi; repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2\u003e/dev/null || printf \"%s\" \"$repo\")\"; RECONC_HOOK_REPO_RESOLVED=1 exec \"$repo/tools/reconc/bin/hook\" antigravity-pre-invocation \"$repo\"'",
        "timeout": 5,
        "type": "command"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'repo=\".\"; hook=\"$repo/tools/reconc/bin/hook\"; if [ -x \"$hook\" ]; then exec \"$hook\" antigravity-pre-tool-use \"$repo\"; fi; repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2\u003e/dev/null || printf \"%s\" \"$repo\")\"; RECONC_HOOK_REPO_RESOLVED=1 exec \"$repo/tools/reconc/bin/hook\" antigravity-pre-tool-use \"$repo\"'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command"
      }
    ],
    "Stop": [
      {
        "command": "sh -c 'repo=\".\"; hook=\"$repo/tools/reconc/bin/hook\"; if [ -x \"$hook\" ]; then exec \"$hook\" antigravity-stop \"$repo\"; fi; repo=\"$(git -C \"$repo\" rev-parse --show-toplevel 2\u003e/dev/null || printf \"%s\" \"$repo\")\"; RECONC_HOOK_REPO_RESOLVED=1 exec \"$repo/tools/reconc/bin/hook\" antigravity-stop \"$repo\"'",
        "timeout": 30,
        "type": "command"
      }
    ]
  }
}
