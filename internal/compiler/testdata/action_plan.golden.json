{
  "format_version": "1",
  "tools": [
    {
      "id": "warehouse-query",
      "transport": "mcp_stdio",
      "server_label": "warehouse",
      "tool": "query",
      "effect": {
        "kind": "external"
      },
      "origin": "actions",
      "source_identity": ".reconc.yml"
    }
  ],
  "rules": [
    {
      "id": "block-production",
      "selector": {
        "tool_ids": [
          "warehouse-query"
        ],
        "phases": [
          "pre_call"
        ]
      },
      "when": {
        "predicate": {
          "source": "arguments",
          "pointer": "/database",
          "op": "eq",
          "value": "production"
        }
      },
      "decision": "block",
      "on_indeterminate": "block",
      "cache": "never",
      "message": "Production access is forbidden.",
      "source_identity": ".reconc.yml"
    }
  ],
  "budgets": [],
  "approvals": [
    {
      "id": "warehouse-summary",
      "selector": {
        "tool_ids": [
          "warehouse-query"
        ],
        "phases": [
          "pre_call"
        ]
      },
      "selected_arguments": [
        "/database"
      ],
      "source_identity": ".reconc.yml"
    }
  ],
  "detectors": [
    {
      "id": "inspect-database",
      "selector": {
        "tool_ids": [
          "warehouse-query"
        ],
        "phases": [
          "pre_call"
        ]
      },
      "pack_id": "reconc-core-v1",
      "pack_digest": "sha256:0b4b8260995839139f2d0ba8521fc1d6f3d98744db854717364612fc626ed972",
      "fields": [
        {
          "source": "arguments",
          "pointer": "/database"
        }
      ],
      "categories": [
        "forbidden_data"
      ],
      "forbidden_terms": [
        "production"
      ],
      "pre_call_decision": "block",
      "post_result_disposition": "withhold",
      "progress_disposition": "suppress",
      "schema_policy": "validate_if_declared",
      "allowed_content_types": [],
      "trusted_annotation_fields": [],
      "limits": {
        "max_bytes": 8388608,
        "max_items": 65536,
        "max_depth": 32,
        "max_milliseconds": 500
      },
      "source_identity": ".reconc.yml"
    }
  ],
  "defaults": {
    "declared_tool": "warn",
    "gateway_unmatched": "block",
    "host_unmatched": "allow",
    "evaluation_error": "block",
    "post_error": "block",
    "progress_error": "block",
    "cache": "never"
  }
}
