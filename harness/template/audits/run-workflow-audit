#!/bin/sh
# Reconc-invoked launcher. Reconc calls this script with the repo root as
# cwd, so all repo-relative paths below resolve against the repo root.
set -eu
repo_root="$(pwd)"
harness="tools/reconc/harness/template"
cache_dir=".reconc/cache"
bin="$cache_dir/workflow-audit-template"
digest_file="$bin.source-digest"
lock_dir="$bin.build.lock"
mkdir -p "$cache_dir"

source_digest() {
  sources="$cache_dir/.workflow-audit-sources.$$"
  manifest="$cache_dir/.workflow-audit-manifest.$$"
  : >"$sources"
  for src in "$harness/go.mod" "$harness/go.sum"; do
    [ -f "$src" ] && printf '%s\n' "$src" >>"$sources"
  done
  if ! find "$harness/audits" -type f -name '*.go' ! -name '*_test.go' -print >>"$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  if ! find tools/reconc/buildprovenance -type f -name '*.go' ! -name '*_test.go' -print >>"$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  if ! LC_ALL=C sort -u "$sources" -o "$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  : >"$manifest"
  while IFS= read -r src; do
    hash="$(git hash-object -- "$src")" || {
      rm -f "$sources" "$manifest"
      return 1
    }
    printf '%s\0%s\n' "$src" "$hash" >>"$manifest" || {
      rm -f "$sources" "$manifest"
      return 1
    }
  done <"$sources"
  digest="$(git hash-object -- "$manifest")" || {
    rm -f "$sources" "$manifest"
    return 1
  }
  rm -f "$sources" "$manifest"
  printf '%s\n' "$digest"
}

needs_rebuild() {
  if [ ! -x "$bin" ]; then
    return 0
  fi
  [ -f "$digest_file" ] || return 0
  cached_digest="$(cat "$digest_file")" || return 0
  [ "$cached_digest" = "$expected_digest" ] || return 0
  return 1
}

acquire_lock() {
  attempts=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    if [ -f "$lock_dir/pid" ]; then
      holder="$(cat "$lock_dir/pid" 2>/dev/null || true)"
      if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$lock_dir"
        continue
      fi
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 300 ]; then
      echo "workflow-audit build lock timed out: $lock_dir" >&2
      return 1
    fi
    sleep 0.2
  done
  printf '%s\n' "$$" >"$lock_dir/pid"
}

expected_digest="$(source_digest)"
if needs_rebuild; then
  acquire_lock
  tmp="$bin.tmp.$$"
  digest_tmp="$digest_file.tmp.$$"
  trap 'rm -f "$tmp" "$digest_tmp"; rm -rf "$lock_dir"' EXIT INT TERM
  expected_digest="$(source_digest)"
  if needs_rebuild; then
    (cd "$harness" && go build -ldflags="-s -w" -trimpath -buildvcs=false -o "$repo_root/$tmp" ./audits)
    chmod 755 "$tmp"
    printf '%s\n' "$expected_digest" >"$digest_tmp"
    mv "$tmp" "$bin"
    mv "$digest_tmp" "$digest_file"
  fi
  rm -rf "$lock_dir"
  trap - EXIT INT TERM
fi
exec "$bin" "$@"
