#!/bin/sh
# Reconc-invoked launcher. Reconc calls this script with the repo root as
# cwd, so all repo-relative paths below resolve against the repo root.
set -eu
repo_root="$(pwd)"
harness="tools/reconc/harness/template"
cache_dir=".reconc/cache"
bin="$cache_dir/workflow-audit-template"
digest_file="$bin.source-digest"
lock_dir="$bin.build.lock"

ensure_real_dir() {
  path="$1"
  if [ -L "$path" ]; then
    echo "workflow-audit state directory must not be a symlink: $path" >&2
    return 1
  fi
  if [ -e "$path" ]; then
    if [ ! -d "$path" ]; then
      echo "workflow-audit state path must be a directory: $path" >&2
      return 1
    fi
    return 0
  fi
  mkdir "$path"
  if [ -L "$path" ] || [ ! -d "$path" ]; then
    echo "workflow-audit state directory identity changed: $path" >&2
    return 1
  fi
}

ensure_real_dir ".reconc"
ensure_real_dir "$cache_dir"

source_digest() {
  sources="$(mktemp "$cache_dir/.workflow-audit-sources.XXXXXX")"
  manifest="$(mktemp "$cache_dir/.workflow-audit-manifest.XXXXXX")"
  for src in "$harness/go.mod" "$harness/go.sum"; do
    [ -f "$src" ] && printf '%s\n' "$src" >>"$sources"
  done
  if ! find "$harness/audits" -type f -name '*.go' ! -name '*_test.go' -print >>"$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  if ! find tools/reconc/buildprovenance -type f -name '*.go' ! -name '*_test.go' -print >>"$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  if ! LC_ALL=C sort -u "$sources" -o "$sources"; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  : >"$manifest"
  failed=0
  while IFS= read -r src; do
    if ! hash="$(git hash-object -- "$src")"; then
      failed=1
      break
    fi
    if ! printf '%s\0%s\n' "$src" "$hash" >>"$manifest"; then
      failed=1
      break
    fi
  done <"$sources"
  if [ "$failed" -ne 0 ]; then
    rm -f "$sources" "$manifest"
    return 1
  fi
  digest="$(git hash-object -- "$manifest")" || {
    rm -f "$sources" "$manifest"
    return 1
  }
  rm -f "$sources" "$manifest"
  printf '%s\n' "$digest"
}

needs_rebuild() {
  if [ -L "$bin" ] || [ ! -f "$bin" ] || [ ! -x "$bin" ]; then
    return 0
  fi
  [ ! -L "$digest_file" ] && [ -f "$digest_file" ] || return 0
  cached_digest="$(dd if="$digest_file" bs=129 count=1 2>/dev/null)" || return 0
  [ "$cached_digest" = "$expected_digest" ] || return 0
  return 1
}

acquire_lock() {
  attempts=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    if [ ! -L "$lock_dir" ] && [ ! -L "$lock_dir/pid" ] && [ -f "$lock_dir/pid" ]; then
      holder="$(dd if="$lock_dir/pid" bs=32 count=1 2>/dev/null || true)"
      case "$holder" in
        ''|*[!0-9]*) holder="" ;;
      esac
      [ "${#holder}" -le 20 ] || holder=""
      if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$lock_dir"
        continue
      fi
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 300 ]; then
      echo "workflow-audit build lock timed out: $lock_dir" >&2
      return 1
    fi
    sleep 0.2
  done
  printf '%s\n' "$$" >"$lock_dir/pid"
}

expected_digest="$(source_digest)"
if needs_rebuild; then
  acquire_lock
  tmp="$(mktemp "$cache_dir/.workflow-audit-bin.XXXXXX")"
  digest_tmp="$(mktemp "$cache_dir/.workflow-audit-digest.XXXXXX")"
  trap 'rm -f "$tmp" "$digest_tmp"; rm -rf "$lock_dir"' EXIT INT TERM
  expected_digest="$(source_digest)"
  if needs_rebuild; then
    (cd "$harness" && go build -ldflags="-s -w" -trimpath -buildvcs=false -o "$repo_root/$tmp" ./audits)
    chmod 755 "$tmp"
    printf '%s\n' "$expected_digest" >"$digest_tmp"
    mv "$tmp" "$bin"
    mv "$digest_tmp" "$digest_file"
  fi
  rm -rf "$lock_dir"
  trap - EXIT INT TERM
fi
exec "$bin" "$@"
