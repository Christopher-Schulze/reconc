{
  "PermissionRequest": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-permission-request \"$DEVIN_PROJECT_DIR\"",
          "timeout": 10,
          "type": "command"
        }
      ],
      "matcher": "^(exec|read|write|edit|apply_patch|notebook_edit|grep|glob|get_output|write_to_process|kill_shell|mcp_call_tool|mcp__.*)$"
    }
  ],
  "PostCompaction": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-post-compaction \"$DEVIN_PROJECT_DIR\"",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-post-tool-use \"$DEVIN_PROJECT_DIR\"",
          "timeout": 5,
          "type": "command"
        }
      ],
      "matcher": "^(exec|read|write|edit|apply_patch|notebook_edit|grep|glob|get_output|write_to_process|kill_shell|mcp_call_tool|mcp__.*)$"
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-pre-tool-use \"$DEVIN_PROJECT_DIR\"",
          "timeout": 10,
          "type": "command"
        }
      ],
      "matcher": "^(exec|read|write|edit|apply_patch|notebook_edit|grep|glob|get_output|write_to_process|kill_shell|mcp_call_tool|mcp__.*)$"
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-session-end \"$DEVIN_PROJECT_DIR\"",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-session-start \"$DEVIN_PROJECT_DIR\"",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-stop \"$DEVIN_PROJECT_DIR\"",
          "timeout": 30,
          "type": "command"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "command": "\"$DEVIN_PROJECT_DIR/tools/reconc/bin/hook\" devin-user-prompt-submit \"$DEVIN_PROJECT_DIR\"",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  ]
}
