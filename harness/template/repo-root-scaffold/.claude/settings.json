{
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-config-change",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "user_settings|project_settings|local_settings"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-notification",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-permission-denied",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|TabWrite|StrReplace|Delete|Bash|PowerShell"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-permission-request",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|TabWrite|StrReplace|Delete|Bash|PowerShell"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-post-compaction",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-post-tool-use",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|TabWrite|StrReplace|Delete|Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-mcp-after",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-post-tool-use-failure",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|TabWrite|StrReplace|Delete|Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-mcp-after",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-pre-compaction",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-pre-tool-use",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|TabWrite|StrReplace|Delete|Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-mcp-before",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__.*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-session-end",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-session-start",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|fork"
      },
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-compaction-recovery",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-stop",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-stop-failure",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-subagent-start",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-subagent-stop",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
              "claude-user-prompt-submit",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
