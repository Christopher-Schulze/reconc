{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "args": [
              "claude-permission-request",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "claude-post-tool-use",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "args": [
              "claude-post-tool-use-failure",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "claude-pre-tool-use",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "args": [
              "claude-session-end",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [
              "claude-session-start",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "args": [
              "claude-post-compaction",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "claude-stop",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "args": [
              "claude-user-prompt-submit",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "command": "${CLAUDE_PROJECT_DIR}/tools/reconc/bin/hook",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
