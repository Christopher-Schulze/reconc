#!/bin/sh
# Root-safe promote-task-done launcher for the nested template harness Go module.
set -eu

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
harness_dir="$(CDPATH='' cd -- "$script_dir/../.." && pwd)"
repo_root="$(git -C "$harness_dir" rev-parse --show-toplevel)"

cd "$harness_dir"
exec go run ./utils/promote-task-done --repo-root "$repo_root" "$@"
