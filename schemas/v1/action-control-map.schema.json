{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v1/action-control-map.schema.json",
  "title": "Reconc Action Control Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "pack_id", "pack_version", "framework", "review_status", "source", "controls"],
  "properties": {
    "schema": {"const": "reconc.action-control-map/v1"},
    "format_version": {"const": "1"},
    "pack_id": {"$ref": "#/$defs/label"},
    "pack_version": {"$ref": "#/$defs/label"},
    "framework": {"$ref": "#/$defs/text"},
    "review_status": {"enum": ["reviewed", "stale", "not-reviewed"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "edition", "source_date", "reviewed_at", "reuse_notice"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "edition": {"$ref": "#/$defs/text"},
        "source_date": {"$ref": "#/$defs/date"},
        "reviewed_at": {"$ref": "#/$defs/date"},
        "reuse_notice": {"$ref": "#/$defs/text"}
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reference", "rationale", "evidence_selectors", "known_gaps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
          "reference": {"$ref": "#/$defs/text"},
          "rationale": {"$ref": "#/$defs/text"},
          "evidence_selectors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/fact"}
          },
          "known_gaps": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/text"}
          }
        }
      }
    }
  },
  "$defs": {
    "label": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\r\\n\\u0000-\\u001f\\u007f]+$"},
    "date": {"type": "string", "format": "date"},
    "fact": {
      "enum": [
        "approval.authority", "approval.receipts", "budget.identity", "budget.state",
        "identity.repository", "ledger.archive-continuity", "ledger.calls.complete",
        "ledger.events.complete", "ledger.integrity", "ledger.policy-identity",
        "ledger.window.complete", "policy.action.rules", "policy.action.tools",
        "policy.lock.current", "scenario.completeness", "scenario.host-coverage",
        "scenario.results"
      ]
    }
  }
}
