{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.9/schemas/v1/ci-statement.schema.json",
  "title": "Reconc CI Statement",
  "$comment": "Runtime verification additionally checks UTF-8 byte bounds, trimmed printable text, sorted unique check IDs, timestamp ranges and ordering, authenticity, freshness and the independently supplied candidate and requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "repository", "candidate", "issued_at", "expires_at", "checks"],
  "properties": {
    "schema": {"const": "reconc.ci-evidence/v1"},
    "format_version": {"const": "1"},
    "repository": {"$ref": "#/$defs/text"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "issued_at": {"$ref": "#/$defs/unixSeconds"},
    "expires_at": {"$ref": "#/$defs/unixSeconds"},
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "run_id", "outcome"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "run_id": {"$ref": "#/$defs/text"},
          "outcome": {"enum": ["success", "failure", "pending", "cancelled"]}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "unixSeconds": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "object_id"],
      "properties": {
        "kind": {"enum": ["commit", "merge-queue"]},
        "object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "not": {"pattern": "^0+$"}}
      }
    }
  }
}
