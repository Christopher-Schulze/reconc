{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconc:schema:ci-verification:v1:sha256:82a55a94302df2678d2b145ca9cb0b370e92a04ba0591d3f2186658213b3c57e",
  "title": "Reconc CI Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "status", "candidate", "detail"],
  "properties": {
    "schema": {"const": "reconc.ci-verification/v1"},
    "format_version": {"const": "1"},
    "status": {"enum": ["verified", "blocked"]},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["kind", "object_id"], "properties": {"kind": {"type": "string"}, "object_id": {"type": "string"}}},
    "evidence_identity": {"$ref": "#/$defs/evidenceIdentity"},
    "detail": {"type": "string", "minLength": 1}
  },
  "if": {"properties": {"status": {"const": "verified"}}},
  "then": {
    "required": ["candidate", "evidence_identity"],
    "properties": {
      "candidate": {"$ref": "urn:reconc:schema:ci-statement:v1:sha256:0bafe23b80bb194315766f0a9612f780a6b31e24c1b9b0a0d58e18e568ded7d9#/$defs/candidate"},
      "evidence_identity": {"$ref": "#/$defs/evidenceIdentity"}
    }
  },
  "else": {"not": {"required": ["evidence_identity"]}},
  "$defs": {
    "evidenceIdentity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
