{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconc:schema:ci-requirement:v1:sha256:9331a35a551a2bc4ab76758c173f57e6fffbb67368d5edb1c7e106c0ae2edfa8",
  "title": "Reconc Trusted CI Requirement",
  "$comment": "The operator must protect this configuration from candidate writes. Runtime validation additionally enforces canonical public-key encoding, sorted unique required checks, UTF-8 byte bounds and a maximum age representable as a Go duration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format_version", "repository", "authority_key_id", "public_key", "required_checks", "max_age_seconds"],
  "properties": {
    "schema": {"const": "reconc.ci-requirement/v1"},
    "format_version": {"const": "1"},
    "repository": {"$ref": "urn:reconc:schema:ci-statement:v1:sha256:0bafe23b80bb194315766f0a9612f780a6b31e24c1b9b0a0d58e18e568ded7d9#/$defs/text"},
    "authority_key_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "required_checks": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "urn:reconc:schema:ci-statement:v1:sha256:0bafe23b80bb194315766f0a9612f780a6b31e24c1b9b0a0d58e18e568ded7d9#/$defs/text"}},
    "max_age_seconds": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}
  }
}
