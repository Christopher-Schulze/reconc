{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json",
  "title": "Reconc compiled policy lock v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "compiler_version",
    "format_version",
    "repo_root",
    "default_mode",
    "rule_count",
    "source_count",
    "source_digest",
    "lock_digest",
    "source_precedence",
    "discovery",
    "sources",
    "rules"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "format_version": {
      "const": "4"
    },
    "repo_root": {
      "const": "."
    },
    "default_mode": {
      "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/mode"
    },
    "rule_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mcp": {
      "$ref": "#/$defs/mcp"
    },
    "custom_runtimes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/customRuntime"
      }
    },
    "source_precedence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcePrecedenceKind"
      },
      "uniqueItems": true
    },
    "discovery": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/discovery"
        },
        {
          "type": "object",
          "properties": {
            "start_path": {
              "const": "."
            },
            "repo_root": {
              "const": "."
            }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/kind"
        },
        "mode": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/mode"
        },
        "message": {
          "type": "string"
        },
        "paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "before_paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "when_paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "commands": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "claims": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "command_match": {
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "required_files": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/requiredFile"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/evidence"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "script": {
          "type": "string"
        },
        "args": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "kill_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "assurance": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/assurance"
          }
        },
        "source_path": {
          "type": "string"
        },
        "source_block_id": {
          "type": "string"
        },
        "deprecated": {
          "type": "boolean"
        },
        "deprecated_reason": {
          "type": "string"
        },
        "deprecated_since": {
          "type": "string"
        },
        "deprecated_replaced_by": {
          "type": "string"
        },
        "scope_paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "scope_id": {
          "type": "string"
        },
        "cache_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/kind"
        },
        "path": {
          "type": "string"
        },
        "max_age_hours": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string"
        },
        "must_exist": {
          "type": "boolean"
        },
        "must_contain": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "must_not_contain": {
          "type": "string"
        },
        "max_line_count": {
          "type": "integer",
          "minimum": 1
        },
        "script": {
          "type": "string"
        },
        "args": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "before_paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "when_paths": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "commands": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "claims": {
          "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.1/schemas/v1/policy-lock.schema.json#/$defs/stringArray"
        },
        "command_match": {
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "cache_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content_sha256"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^(?:/|\\\\|[A-Za-z]:[\\\\/])"
              },
              {
                "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
              }
            ]
          }
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unclassified",
        "tools"
      ],
      "properties": {
        "unclassified": {
          "enum": [
            "host",
            "deny"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcpTool"
          }
        }
      }
    },
    "mcpTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "tool",
        "effect",
        "source_path"
      ],
      "properties": {
        "platform": {
          "anyOf": [
            {
              "enum": [
                "cursor",
                "opencode",
                "kilo",
                "omp",
                "pi",
                "zcode"
              ]
            },
            {
              "type": "string",
              "pattern": "^custom:[a-z0-9][a-z0-9_-]{0,47}$"
            }
          ]
        },
        "server_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "effect": {
          "enum": [
            "repository_read",
            "repository_write",
            "command",
            "external"
          ]
        },
        "path_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jsonPointer"
          }
        },
        "command_field": {
          "$ref": "#/$defs/jsonPointer"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "enum": [
                  "repository_read",
                  "repository_write"
                ]
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "required": [
              "path_fields"
            ],
            "not": {
              "required": [
                "command_field"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "command"
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "required": [
              "command_field"
            ],
            "not": {
              "required": [
                "path_fields"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "external"
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path_fields"
                  ]
                },
                {
                  "required": [
                    "command_field"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "sourceKind": {
      "enum": [
        "global",
        "claude_md",
        "agents_md",
        "start_md",
        "inline_block",
        "compiler_config",
        "preset",
        "policy_file",
        "custom_runtime"
      ]
    },
    "sourcePrecedenceKind": {
      "enum": [
        "global",
        "claude_md",
        "agents_md",
        "start_md",
        "inline_block",
        "compiler_config",
        "preset",
        "policy_file"
      ]
    },
    "customRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "runtime",
        "manifest_digest",
        "route_count",
        "degraded_routes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^custom:[a-z0-9][a-z0-9_-]{0,47}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "route_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "degraded_routes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        }
      }
    }
  }
}
