{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v5/policy-lock.schema.json",
  "title": "Reconc compiled policy lock v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "compiler_version",
    "format_version",
    "repo_root",
    "default_mode",
    "rule_count",
    "source_count",
    "source_digest",
    "lock_digest",
    "source_precedence",
    "discovery",
    "sources",
    "rules",
    "actions"
  ],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v5/policy-lock.schema.json" },
    "compiler_version": { "type": "string", "minLength": 1 },
    "format_version": { "const": "5" },
    "repo_root": { "const": "." },
    "default_mode": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/default_mode" },
    "rule_count": { "type": "integer", "minimum": 0 },
    "source_count": { "type": "integer", "minimum": 0 },
    "source_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lock_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "custom_runtimes": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/custom_runtimes" },
    "source_precedence": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/source_precedence" },
    "discovery": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/discovery" },
    "sources": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/sources" },
    "rules": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.4/schemas/v4/policy-lock.schema.json#/properties/rules" },
    "actions": { "$ref": "#/$defs/actions" }
  },
  "$defs": {
    "safeLabel": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/safeLabel" },
    "identity": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/identity" },
    "platform": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/platform" },
    "toolName": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/toolName" },
    "effect": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/effect" },
    "selector": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/selector" },
    "condition": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/condition" },
    "decision": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/decision" },
    "cache": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/cache" },
    "budgetSelector": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/budgetSelector" },
    "budgetLimits": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/budgetLimits" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "tool", "effect", "origin", "source_identity"],
      "properties": {
        "id": { "$ref": "#/$defs/safeLabel" },
        "transport": { "enum": ["host_mcp", "mcp_stdio"] },
        "platform": { "$ref": "#/$defs/platform" },
        "server_label": { "$ref": "#/$defs/safeLabel" },
        "server_fingerprint": { "$ref": "#/$defs/identity" },
        "tool": { "$ref": "#/$defs/toolName" },
        "effect": { "$ref": "#/$defs/effect" },
        "cost_units": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "max_result_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "origin": { "enum": ["actions", "legacy_mcp"] },
        "source_identity": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "host_mcp" } }, "required": ["transport"] },
          "then": {
            "required": ["platform"],
            "not": { "required": ["server_label"] },
            "properties": { "server_fingerprint": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/hostFingerprint" } }
          }
        },
        {
          "if": { "properties": { "transport": { "const": "mcp_stdio" } }, "required": ["transport"] },
          "then": {
            "required": ["server_label"],
            "not": { "required": ["platform"] },
            "properties": {
              "server_fingerprint": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/serverFingerprint" },
              "tool": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v3/policy-config.schema.json#/$defs/gatewayToolName" }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "decision", "on_indeterminate", "cache", "source_identity"],
      "properties": {
        "id": { "$ref": "#/$defs/safeLabel" },
        "selector": { "$ref": "#/$defs/selector" },
        "when": { "$ref": "#/$defs/condition" },
        "decision": { "$ref": "#/$defs/decision" },
        "on_indeterminate": { "enum": ["require_approval", "block"] },
        "cache": { "$ref": "#/$defs/cache" },
        "message": { "type": "string", "maxLength": 512 },
        "source_identity": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "limits", "reset", "on_exhaustion", "source_identity"],
      "properties": {
        "id": { "$ref": "#/$defs/safeLabel" },
        "selector": { "$ref": "#/$defs/budgetSelector" },
        "limits": { "$ref": "#/$defs/budgetLimits" },
        "reset": { "enum": ["never", "operator_run", "operator_session", "fixed_window"] },
        "window_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "on_exhaustion": { "const": "block" },
        "source_identity": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "reset": { "const": "fixed_window" } }, "required": ["reset"] },
          "then": { "required": ["window_seconds"] },
          "else": { "not": { "required": ["window_seconds"] } }
        },
        {
          "if": { "properties": { "limits": { "required": ["rate_window"] } }, "required": ["limits"] },
          "then": { "properties": { "reset": { "const": "fixed_window" } } }
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_tool", "gateway_unmatched", "host_unmatched", "evaluation_error", "post_error", "progress_error", "cache"],
      "properties": {
        "declared_tool": { "$ref": "#/$defs/decision" },
        "gateway_unmatched": { "const": "block" },
        "host_unmatched": { "enum": ["allow", "block"] },
        "evaluation_error": { "const": "block" },
        "post_error": { "const": "block" },
        "progress_error": { "const": "block" },
        "cache": { "$ref": "#/$defs/cache" }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "tools", "rules", "budgets", "defaults"],
      "properties": {
        "format_version": { "const": "1" },
        "tools": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/tool" } },
        "rules": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/rule" } },
        "budgets": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/budget" } },
        "defaults": { "$ref": "#/$defs/defaults" }
      }
    }
  }
}
