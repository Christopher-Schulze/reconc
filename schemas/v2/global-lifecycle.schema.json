{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconc:schema:global-lifecycle:v2:sha256:4b0b882eaa20dd814bb1f7ef22e27425471f5b907bbedb26668a86b4f902b261",
  "title": "Reconc global lifecycle report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "operation",
    "status",
    "changed",
    "owner",
    "current_version",
    "target_version",
    "channel",
    "binary_path",
    "receipt_path",
    "plan_digest",
    "skill",
    "checks",
    "actions",
    "next_action"
  ],
  "properties": {
    "$schema": {
      "const": "urn:reconc:schema:global-lifecycle:v2:sha256:4b0b882eaa20dd814bb1f7ef22e27425471f5b907bbedb26668a86b4f902b261"
    },
    "format_version": { "const": "reconc.global-lifecycle/v2" },
    "operation": { "enum": ["update.check", "update.apply", "uninstall"] },
    "status": {
      "enum": [
        "current",
        "update-available",
        "updated",
        "uninstalled",
        "refused",
        "failed"
      ]
    },
    "changed": { "type": "boolean" },
    "owner": {
      "type": ["string", "null"],
      "enum": ["direct", "source", null]
    },
    "current_version": {
      "type": "string",
      "maxLength": 128
    },
    "target_version": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "channel": {
      "type": ["string", "null"],
      "enum": ["stable", "preview", "exact", "source", null]
    },
    "binary_path": { "$ref": "#/$defs/nullablePath" },
    "receipt_path": { "$ref": "#/$defs/nullablePath" },
    "plan_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "skill": {
      "oneOf": [{ "$ref": "#/$defs/skill" }, { "type": "null" }]
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" },
      "maxItems": 96
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" },
      "maxItems": 16
    },
    "next_action": { "type": "string", "minLength": 1, "maxLength": 4112 }
  },
  "$defs": {
    "nullablePath": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 32768
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "enum": ["pass", "warn", "fail"] },
        "detail": { "type": "string", "maxLength": 4112 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "detail"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "command": { "type": "string", "maxLength": 4112 },
        "detail": { "type": "string", "maxLength": 4112 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "installed_manifest_digest", "target_manifest_digest", "discovery", "action"],
      "properties": {
        "state": { "enum": ["missing", "unmanaged", "current", "stale-owned", "modified-owned", "unavailable"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "installed_manifest_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "target_manifest_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "discovery": { "type": "string", "maxLength": 4112 },
        "action": { "oneOf": [{ "$ref": "#/$defs/skillAction" }, { "type": "null" }] }
      }
    },
    "skillAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv", "cwd", "authorization"],
      "properties": {
        "kind": { "const": "install-skill" },
        "argv": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 32768 } },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "authorization": { "const": "explicit-user-action" }
      }
    }
  }
}
