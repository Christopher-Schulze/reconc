{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.9/schemas/v2/policy-fix-plan.schema.json",
  "title": "Reconc policy fix plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "decision",
    "summary",
    "repo_root",
    "lockfile_path",
    "inputs",
    "violation_count",
    "blocking_violation_count",
    "remediation_count",
    "remediations"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "format_version": { "const": "2" },
    "decision": { "enum": ["pass", "warn", "block"] },
    "summary": { "type": "string" },
    "repo_root": { "type": "string" },
    "lockfile_path": { "type": "string" },
    "inputs": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v1/policy-report.schema.json#/$defs/inputs" },
    "violation_count": { "type": "integer", "minimum": 0 },
    "blocking_violation_count": { "type": "integer", "minimum": 0 },
    "remediation_count": { "type": "integer", "minimum": 0 },
    "remediations": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediation" }
    },
    "omissions": { "$ref": "#/$defs/omissions" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "omissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_items": { "type": "integer", "minimum": 1 },
        "remediations": { "type": "integer", "minimum": 1 },
        "remediation_items": { "type": "integer", "minimum": 1 },
        "actions": { "type": "integer", "minimum": 1 },
        "action_items": { "type": "integer", "minimum": 1 }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "kind",
        "mode",
        "priority",
        "message",
        "why",
        "recommended_action",
        "steps",
        "can_autofix"
      ],
      "properties": {
        "rule_id": { "type": "string" },
        "kind": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v1/policy-report.schema.json#/$defs/kind" },
        "mode": { "$ref": "https://raw.githubusercontent.com/Christopher-Schulze/reconc/reconc-v0.9.6/schemas/v1/policy-report.schema.json#/$defs/mode" },
        "priority": { "enum": ["blocking", "non-blocking"] },
        "message": { "type": "string" },
        "why": { "type": "string" },
        "recommended_action": { "type": "string" },
        "suggested_commands": { "$ref": "#/$defs/stringArray" },
        "forbidden_commands": { "$ref": "#/$defs/stringArray" },
        "suggested_claims": { "$ref": "#/$defs/stringArray" },
        "files_to_inspect": { "$ref": "#/$defs/stringArray" },
        "steps": { "$ref": "#/$defs/stringArray" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "source_path": { "type": "string" },
        "source_block_id": { "type": "string" },
        "can_autofix": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind"],
      "properties": {
        "code": {
          "enum": ["run_command", "assert_claim", "provide_evidence", "refresh", "retry", "inspect", "request_approval"]
        },
        "kind": {
          "enum": ["argv", "shell", "evidence", "inspection", "approval"]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "shell": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string" },
        "authorization": { "enum": ["operator_approval", "policy_update"] },
        "required_evidence": { "$ref": "#/$defs/stringArray" },
        "required_claims": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "argv" } }, "required": ["kind"] },
          "then": { "required": ["argv"], "not": { "required": ["shell"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "shell" } }, "required": ["kind"] },
          "then": { "required": ["shell"], "not": { "required": ["argv"] } }
        }
      ]
    }
  }
}
