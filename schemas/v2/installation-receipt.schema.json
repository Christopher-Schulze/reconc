{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reconc:schema:installation-receipt:v2:sha256:2a5259b3820e737b64ddbf77cbe57be2b904d1924a114fcb67ba0726a94c002d",
  "title": "Reconc global installation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format_version",
    "manager",
    "channel",
    "version",
    "source_repository",
    "release_tag",
    "artifact_name",
    "artifact_sha256",
    "binary_path",
    "goos",
    "goarch",
    "source_digest",
    "provenance_state",
    "installed_at",
    "receipt_digest"
  ],
  "properties": {
    "$schema": { "const": "urn:reconc:schema:installation-receipt:v2:sha256:2a5259b3820e737b64ddbf77cbe57be2b904d1924a114fcb67ba0726a94c002d" },
    "format_version": { "const": "2" },
    "manager": { "enum": ["direct", "source"] },
    "channel": { "enum": ["stable", "preview", "exact", "source"] },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$",
      "maxLength": 128
    },
    "source_repository": {
      "enum": ["Christopher-Schulze/reconc", "local-source"]
    },
    "release_tag": {
      "type": ["string", "null"],
      "pattern": "^reconc-v[0-9A-Za-z][0-9A-Za-z.+-]*$",
      "maxLength": 140
    },
    "artifact_name": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$",
      "maxLength": 255
    },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "binary_path": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "goos": { "type": "string", "pattern": "^[a-z0-9]+$", "maxLength": 32 },
    "goarch": { "type": "string", "pattern": "^[a-z0-9]+$", "maxLength": 32 },
    "source_digest": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "const": "unavailable" }
      ]
    },
    "provenance_state": {
      "enum": ["github-verified", "embedded-verified", "source-local"]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifest_digest", "files"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/skillFile" }
        }
      }
    },
    "installed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "receipt_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "skillFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(SKILL\\.md|references/[a-z0-9-]+\\.md)$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
