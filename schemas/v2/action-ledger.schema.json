              {"properties": {"decision": {"properties": {"decision": {"const": "block"}, "reason_code": {"const": "result_withheld"}}}}}
            ]
          },
          "else": {"properties": {"result_inspection": {"properties": {"categories": {"maxItems": 0}}}}}
        },
        {
          "if": {"properties": {"result_inspection": {"properties": {"status": {"const": "incomplete"}}}}},
          "then": {
            "properties": {
              "decision": {
                "properties": {
                  "decision": {"const": "block"},
                  "reason_code": {
                    "enum": [
                      "inspection_incomplete", "unsupported_content", "schema_invalid", "limit_exceeded",
                      "invalid_utf8", "cancelled", "deadline_exceeded"
